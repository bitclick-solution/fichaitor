# Fichaitor — entorno de la conversación en PRODUCCIÓN (contenedor fichaitor-conversation).
#
# Cópialo en el servidor como /opt/bitclick/fichaitor/conversation.env, con modo 600:
#   install -m 600 env.conversation.example /opt/bitclick/fichaitor/conversation.env
# El archivo real nunca se sube al repositorio ni a GitHub.
#
# Formato: VARIABLE=valor, sin espacios alrededor del "=" y sin comillas.
# Si un valor lleva el signo "$", ponlo entre comillas simples.
#
# AQUÍ NO VA FICHAITOR_TOKEN_PRIVATE_KEY: la conversación crea la acción cuando el dueño
# confirma, pero solo el worker la ejecuta. El proceso se niega a arrancar si la recibe,
# y deploy.sh se niega a desplegar si la encuentra en este archivo.

# === Obligatorias =============================================================

# Conexión a PostgreSQL con el usuario fichaitor_conversation_prod (hereda de
# fichaitor_conversation). NO la rellenes a mano: la escribe init-roles.sh.
FICHAITOR_CONVERSATION_DATABASE_URL=

# Token del bot @FichaitorBot que da BotFather. Sin él, el proceso arranca pero no
# envía nada: las propuestas se quedan en el panel.
FICHAITOR_TELEGRAM_BOT_TOKEN=
FICHAITOR_TELEGRAM_BOT_USERNAME=FichaitorBot

# El MISMO secreto que en api.env: la API crea los códigos y la conversación los
# comprueba. deploy.sh comprueba que coinciden. Genera uno en el servidor:
#   openssl rand -hex 32
FICHAITOR_LINK_CODE_PEPPER=

# Solo para registrar el webhook a mano (docs/despliegue.md, "Webhook de Telegram"):
# el mismo valor que en api.env.
FICHAITOR_TELEGRAM_WEBHOOK_SECRET=

# El modelo que redacta la respuesta propuesta (el mismo que el borrador del panel).
# Sin clave, las reseñas no se proponen por Telegram: se quedan en el panel.
FICHAITOR_GEMINI_API_KEY=
FICHAITOR_GEMINI_MODEL=gemini-3.6-flash

# === Fijadas por docker-compose.prod.yml (no las pongas aquí) =================
#   FICHAITOR_FAKE_SCREENSHOT=false
#   FICHAITOR_TELEGRAM_POLLING=false

# === Opcionales (estos son los valores por defecto) ===========================

# Enlaces de los textos del bot.
FICHAITOR_CHANNELS_PANEL_URL=https://fichaitor.es/app
FICHAITOR_CHANNELS_SIGNUP_URL=https://fichaitor.es
FICHAITOR_CHANNELS_RECONNECT_URL=https://fichaitor.es/app
FICHAITOR_CHANNELS_PRIVACY_URL=https://fichaitor.es/privacidad/
# Mensajes proactivos por semana (sin contar reseñas) y horario de silencio.
FICHAITOR_PROACTIVE_WEEKLY_CAP=2
FICHAITOR_QUIET_HOURS_START=21:00
FICHAITOR_QUIET_HOURS_END=09:00
# Códigos incorrectos de todos los chats juntos por hora; pasado el límite, los códigos
# tecleados esperan a la hora siguiente (el enlace sigue funcionando).
FICHAITOR_LINK_GLOBAL_MAX_FAILURES=50
# Borradores por cuenta y día: los mismos que en api.env (se cuentan juntos).
FICHAITOR_REVIEW_DRAFT_RATE_LIMIT=30
FICHAITOR_REVIEW_DRAFT_TIMEOUT_SECONDS=20
# Jobs: espera con la cola vacía, tiempo máximo y bloqueo.
FICHAITOR_WORKER_POLL_INTERVAL_SECONDS=2
FICHAITOR_WORKER_JOB_TIMEOUT_SECONDS=30
FICHAITOR_WORKER_LOCK_TIMEOUT_SECONDS=120
# Cada cuántos segundos mira el planificador qué toca encolar.
FICHAITOR_PLANNER_INTERVAL_SECONDS=60
