# Fichaitor — entorno del proceso de cobro en PRODUCCIÓN (contenedor fichaitor-billing).
#
# Cópialo en el servidor como /opt/bitclick/fichaitor/billing.env, con modo 600:
#   install -m 600 env.billing.example /opt/bitclick/fichaitor/billing.env
# El archivo real nunca se sube al repositorio ni a GitHub. Guarda una copia de las dos
# claves en el gestor de contraseñas.
#
# Formato: VARIABLE=valor, sin espacios alrededor del "=" y sin comillas.
#
# Es el ÚNICO archivo con la clave de Stripe y la de Odoo (docs/admin-facturacion.md, 4.1
# y 9.0.1). deploy.sh rechaza esas claves en cualquier otro archivo de entorno.

# === Obligatorias =============================================================

# Conexión a PostgreSQL con el usuario fichaitor_billing_prod (hereda de fichaitor_billing).
# NO la rellenes a mano: la escribe init-roles.sh con una contraseña generada en el servidor.
FICHAITOR_BILLING_DATABASE_URL=

# Clave RESTRINGIDA de Stripe (rk_test_... hasta el lanzamiento; rk_live_... después), con
# los permisos de la sección 4.1 de docs/admin-facturacion.md. Nunca la clave secreta
# completa (sk_...) en el servidor.
FICHAITOR_STRIPE_SECRET_KEY=
# false con una clave de prueba; true SOLO con una clave live. deploy.sh comprueba que
# los dos casan.
FICHAITOR_STRIPE_LIVEMODE=false

# === Odoo de Bitclick (facturas legales; decisión 9.0.1, sin módulo) ===========
# Sin FICHAITOR_ODOO_URL no se emite ninguna factura: quedan pendientes (y el registro
# avisa con invoice_overdue). Los id son los del Odoo del propietario: docs/despliegue.md,
# «Cobro: Stripe, Odoo y el túnel».
FICHAITOR_ODOO_URL=https://erp.bitclick.solutions
FICHAITOR_ODOO_DB=
# Clave de API del usuario técnico «Fichaitor facturación» (solo permisos de facturación).
FICHAITOR_ODOO_API_KEY=
# Diario de ventas «Fichaitor» (prefijo FTR, con secuencia propia de rectificativas, RFTR).
FICHAITOR_ODOO_JOURNAL_ID=
# Diario de banco «Stripe», donde se registra el cobro de cada factura.
FICHAITOR_ODOO_PAYMENT_JOURNAL_ID=
# Impuestos de venta: 21 %, no sujeto (0 %) y UE con inversión del sujeto pasivo (0 %).
FICHAITOR_ODOO_TAX_IVA_21=
FICHAITOR_ODOO_TAX_NO_SUJETO=
FICHAITOR_ODOO_TAX_ISP_UE=
# Productos de Odoo de cada plan.
FICHAITOR_ODOO_PRODUCT_PRO=
FICHAITOR_ODOO_PRODUCT_PRO_WHATSAPP=
# Posiciones fiscales (opcionales): nacional, canarias, extracomunitario, intracomunitario.
FICHAITOR_ODOO_FPOS_NACIONAL=
FICHAITOR_ODOO_FPOS_CANARIAS=
FICHAITOR_ODOO_FPOS_EXTRACOMUNITARIO=
FICHAITOR_ODOO_FPOS_INTRACOMUNITARIO=
# Campo de estado del módulo VERI*FACTU en account.move (opcional). Si lo pones, una
# factura rechazada o aceptada con errores queda en revisión y no se envía.
FICHAITOR_ODOO_VERIFACTU_FIELD=

# === Fijadas por docker-compose.prod.yml (no las pongas aquí) =================
# deploy.sh rechaza cualquier FICHAITOR_FAKE_* activo.
#   FICHAITOR_FAKE_STRIPE=false
#   FICHAITOR_FAKE_ODOO=false
#   FICHAITOR_PUBLIC_BASE_URL=https://fichaitor.es

# === Opcionales (estos son los valores por defecto) ===========================

# Oferta del correo del fin de la beta (decisión 9.0, 10: sin decidir). Vacía: sin oferta.
FICHAITOR_BILLING_BETA_OFFER=
# Hora (UTC) de los jobs diarios: conciliación, avisos de renovación, fin de la beta y purga.
FICHAITOR_BILLING_DAILY_HOUR_UTC=5
FICHAITOR_WORKER_POLL_INTERVAL_SECONDS=2
# Debe ser menor que el bloqueo y que el stop_grace_period del Compose (250 s).
FICHAITOR_WORKER_JOB_TIMEOUT_SECONDS=240
FICHAITOR_WORKER_LOCK_TIMEOUT_SECONDS=300
