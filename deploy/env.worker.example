# Fichaitor — entorno del worker en PRODUCCIÓN (contenedor fichaitor-worker).
#
# Cópialo en el servidor como /opt/bitclick/fichaitor/worker.env, con modo 600:
#   install -m 600 env.worker.example /opt/bitclick/fichaitor/worker.env
# El archivo real nunca se sube al repositorio ni a GitHub.
#
# Formato: VARIABLE=valor, sin espacios alrededor del "=" y sin comillas.
# Si un valor lleva el signo "$", ponlo entre comillas simples.
#
# Es el ÚNICO archivo con la clave privada de los tokens. El worker valida estas
# variables al arrancar: si falta alguna, termina con código 2 y dice cuál.

# === Obligatorias =============================================================

# Conexión a PostgreSQL con el usuario fichaitor_worker_prod (hereda de fichaitor_worker).
# NO la rellenes a mano: la escribe init-roles.sh con una contraseña generada en
# el servidor. Formato: postgresql://fichaitor_worker_prod:<contraseña>@fichaitor-db:5432/fichaitor
FICHAITOR_WORKER_DATABASE_URL=

# Clave PRIVADA que descifra los tokens de renovación de Google (32 bytes en base64).
# Sale de scripts/gen_token_keys.py, junto con la pública que va en api.env.
# Guarda una copia fuera del servidor (gestor de contraseñas). Si se pierde, todos
# los clientes tienen que volver a conectar Google: deploy/restore.md.
FICHAITOR_TOKEN_PRIVATE_KEY=

# Cliente OAuth de Google: los mismos dos valores que en api.env.
FICHAITOR_GOOGLE_CLIENT_ID=
FICHAITOR_GOOGLE_CLIENT_SECRET=

# Correo saliente (código de baja, baja programada, baja cancelada). Sin SMTP_HOST ni
# MAIL_FROM el worker no envía correo y la API responde 503 al pedir un código de baja.
FICHAITOR_SMTP_HOST=smtp.ionos.es
FICHAITOR_SMTP_PORT=587
FICHAITOR_SMTP_USER=avisos@fichaitor.es
FICHAITOR_SMTP_PASSWORD=
FICHAITOR_MAIL_FROM=avisos@fichaitor.es
FICHAITOR_MAIL_FROM_NAME=Fichaitor
FICHAITOR_MAIL_REPLY_TO=soporte@fichaitor.es
# Base de los enlaces de los correos (restaurar, entrar). Absoluta, sin barra final.
FICHAITOR_PUBLIC_BASE_URL=https://fichaitor.es

# Gemini, para el análisis de opinión. Clave de pago: en el EEE no se puede usar la gratuita.
FICHAITOR_GEMINI_API_KEY=
FICHAITOR_GEMINI_MODEL=gemini-3.6-flash
# Proveedor de Gemini: aistudio (la clave de arriba; la beta) o vertex (Vertex AI en
# Google Cloud; producción). Con vertex la clave de arriba (AI Studio) no se usa. Pasos en
# docs/despliegue.md, «Gemini en Vertex AI». En Vertex AI gemini-3.6-flash se retira el
# 19-11-2026: al pasar a vertex, pon FICHAITOR_GEMINI_MODEL=gemini-3.8-flash.
FICHAITOR_GEMINI_PROVIDER=aistudio
# Solo con vertex. «eu» es la multirregión de la UE: el procesamiento no sale de la UE.
FICHAITOR_VERTEX_PROJECT=
FICHAITOR_VERTEX_LOCATION=eu
# Solo con vertex. Clave de API de Agent Platform VINCULADA a una cuenta de servicio
# (con el proyecto de arriba, admite eu). Si la pones, se usa ella y no se lee el
# archivo de abajo. Una clave del modo exprés no lleva proyecto y solo admite global:
# con eu el proceso no arranca. Pasos en docs/despliegue.md, «Gemini en Vertex AI».
FICHAITOR_VERTEX_API_KEY=
# Ruta, DENTRO del contenedor, de la clave JSON de la cuenta de servicio. La monta
# docker-compose.prod.yml de solo lectura desde <carpeta del despliegue>/vertex/.
# Vacía: Application Default Credentials (no las hay en el VPS: déjala puesta).
# Con FICHAITOR_VERTEX_API_KEY no se usa (puede quedarse puesta aunque no exista).
FICHAITOR_VERTEX_CREDENTIALS_FILE=/run/secrets/vertex/cuenta-servicio.json

# === Fijadas por docker-compose.prod.yml (no las pongas aquí) =================
# deploy.sh rechaza cualquier FICHAITOR_FAKE_* activo.
#   FICHAITOR_FAKE_GOOGLE=false
#   FICHAITOR_FAKE_SCREENSHOT=false
#   FICHAITOR_FAKE_MAIL=false

# === Opcionales (estos son los valores por defecto) ===========================

# Segundos de espera entre consultas cuando la cola está vacía.
FICHAITOR_WORKER_POLL_INTERVAL_SECONDS=2
# Tiempo máximo de un job. Debe ser menor que el bloqueo de la línea siguiente y
# que el stop_grace_period del servicio en el Compose (130 s).
FICHAITOR_WORKER_JOB_TIMEOUT_SECONDS=120
# Antigüedad del bloqueo a partir de la cual un job se da por abandonado.
FICHAITOR_WORKER_LOCK_TIMEOUT_SECONDS=300
# Nombre del worker en la cola y en el registro. Vacío no vale: si no quieres
# fijarlo, deja la línea comentada y se usa <host>-<pid>.
# FICHAITOR_WORKER_ID=fichaitor-worker-1
