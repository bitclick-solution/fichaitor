# Fichaitor — entorno del backoffice en PRODUCCIÓN (contenedor fichaitor-admin).
#
# Cópialo en el servidor como /opt/bitclick/fichaitor/admin.env, con modo 600:
#   install -m 600 env.admin.example /opt/bitclick/fichaitor/admin.env
#
# El backoffice solo se abre por túnel SSH (docs/despliegue.md, «Cobro: Stripe, Odoo y el
# túnel»). Este archivo NO puede llevar nada de Stripe ni de Odoo (ninguna variable que
# contenga STRIPE_ u ODOO_), ni SMTP ni Google: deploy.sh lo rechaza.

# Conexión a PostgreSQL con el usuario fichaitor_admin_prod (hereda de fichaitor_admin).
# NO la rellenes a mano: la escribe init-roles.sh.
FICHAITOR_ADMIN_DATABASE_URL=

# Clave de cifrado de los secretos TOTP y «pimienta» de las contraseñas (paso 12).
# Genéralas en el servidor con: openssl rand -hex 32. Copia en el gestor de contraseñas.
FICHAITOR_ADMIN_TOTP_KEY=
FICHAITOR_ADMIN_PASSWORD_PEPPER=

# authserv-id del servidor de correo, para la baja pedida por correo (DMARC).
FICHAITOR_ADMIN_AUTHSERV_ID=
