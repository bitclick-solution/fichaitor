# Fichaitor — entorno del backoffice en PRODUCCIÓN (contenedor fichaitor-admin).
#
# Cópialo en el servidor como /opt/bitclick/fichaitor/admin.env, con modo 600:
#   install -m 600 env.admin.example /opt/bitclick/fichaitor/admin.env
#
# El backoffice solo se abre por túnel SSH (docs/despliegue.md, «Cobro: Stripe, Odoo y el
# túnel»). Este archivo NO puede llevar nada de Stripe ni de Odoo (ninguna variable que
# contenga STRIPE_ u ODOO_), ni SMTP ni Google: deploy.sh lo rechaza.

# Conexión a PostgreSQL con el usuario fichaitor_admin_prod (hereda de fichaitor_admin).
# NO la rellenes a mano: la escribe init-roles.sh.
FICHAITOR_ADMIN_DATABASE_URL=

# Clave de cifrado de los secretos TOTP (AES-256-GCM: 64 caracteres hexadecimales) y
# «pimienta» de las contraseñas y de los códigos de recuperación (32 caracteres o más).
# Dos valores distintos. Genéralos en el servidor con: openssl rand -hex 32. Guarda una
# copia en el gestor de contraseñas: si se pierden, nadie puede entrar en el backoffice y
# hay que restablecer a todas las personas (scripts/admin_usuario.py restablecer).
# No los cambies sin restablecer a todas las personas: los TOTP y las contraseñas guardadas
# dejan de valer.
FICHAITOR_ADMIN_TOTP_KEY=
FICHAITOR_ADMIN_PASSWORD_PEPPER=

# authserv-id del servidor de correo: lo primero de la cabecera Authentication-Results que
# pone nuestro servidor (por ejemplo, mx.fichaitor.es). Sirve para comprobar el DMARC de
# una baja pedida por correo. deploy.sh lo exige.
FICHAITOR_ADMIN_AUTHSERV_ID=
