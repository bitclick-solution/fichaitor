# Fichaitor — entorno de la API en PRODUCCIÓN (contenedor fichaitor-api).
#
# Cópialo en el servidor como /opt/bitclick/fichaitor/api.env, con modo 600:
#   install -m 600 env.api.example /opt/bitclick/fichaitor/api.env
# El archivo real nunca se sube al repositorio ni a GitHub.
#
# Formato: VARIABLE=valor, sin espacios alrededor del "=" y sin comillas.
# Si un valor lleva el signo "$", ponlo entre comillas simples: Docker Compose
# interpreta los "$" de los valores sin comillas.
#
# AQUÍ NO VA FICHAITOR_TOKEN_PRIVATE_KEY. La clave privada solo existe en worker.env.
# deploy.sh se niega a desplegar si la encuentra en este archivo.

# === Obligatorias =============================================================

# Conexión a PostgreSQL con el usuario fichaitor_api_prod (hereda de fichaitor_api).
# NO la rellenes a mano: la escribe init-roles.sh con una contraseña generada en
# el servidor. Formato: postgresql://fichaitor_api_prod:<contraseña>@fichaitor-db:5432/fichaitor
FICHAITOR_DATABASE_URL=

# Clave de Google Places API (New). Ponle un límite de gasto diario en Google Cloud
# y restríngela a esa API.
FICHAITOR_PLACES_API_KEY=

# Cliente OAuth de Google (tipo "Web application"). Los mismos dos valores van en
# worker.env. Sin el identificador, la API arranca SIN conexión con Google y no avisa.
FICHAITOR_GOOGLE_CLIENT_ID=
FICHAITOR_GOOGLE_CLIENT_SECRET=

# Secreto que firma el parámetro state de OAuth. Genera uno en el servidor:
#   openssl rand -base64 48 | tr -d '\n=+/'
FICHAITOR_OAUTH_STATE_SECRET=

# Clave PÚBLICA que cifra los tokens de Google. Sale de scripts/gen_token_keys.py
# (docs/despliegue.md, "Genera el par de claves"). La privada va solo en worker.env.
FICHAITOR_TOKEN_PUBLIC_KEY=

# Versión de la clave. Súbela solo si algún día se rota el par.
FICHAITOR_TOKEN_KEY_VERSION=1

# === Fijadas por docker-compose.prod.yml (no las pongas aquí) =================
# El Compose de producción impone estos valores y gana a lo que diga este archivo:
#   FICHAITOR_POST_CONNECT_URL=https://fichaitor.es/app
#   FICHAITOR_GOOGLE_REDIRECT_URI=https://fichaitor.es/api/v1/google/oauth/callback
#   FICHAITOR_COOKIE_SECURE=true
#   FICHAITOR_TRUST_PROXY_HEADERS=true
#   FICHAITOR_FAKE_PLACES=false
#   FICHAITOR_FAKE_GOOGLE=false
#   FICHAITOR_FAKE_SCREENSHOT=false

# === Demostración por captura de reseñas (docs/pantallazo.md) =================

# Clave de la API de Gemini, de un proyecto de PAGO (obligatorio para usuarios del
# Espacio Económico Europeo). Opcional: si se deja vacía, la ruta de la captura
# no existe y el resto de la API funciona igual.
FICHAITOR_GEMINI_API_KEY=
FICHAITOR_GEMINI_MODEL=gemini-3.6-flash
# Tamaño máximo de la captura, en bytes (tope: 12000000).
FICHAITOR_SCREENSHOT_MAX_BYTES=6000000
# Capturas por IP en cada ventana. Cada captura son hasta dos llamadas de pago.
FICHAITOR_SCREENSHOT_RATE_LIMIT=3
FICHAITOR_SCREENSHOT_RATE_WINDOW_SECONDS=3600
# Capturas entre todos los clientes cada día (UTC): es el tope de la factura. Se cuenta
# en PostgreSQL: un reinicio, un despliegue o una segunda réplica no lo ponen a cero.
FICHAITOR_SCREENSHOT_DAILY_LIMIT=300
FICHAITOR_SCREENSHOT_TIMEOUT_SECONDS=30
# Por debajo de esta confianza sobre qué pantalla es, la captura se rechaza.
FICHAITOR_SCREENSHOT_MIN_CONFIDENCE=0.6

# === Límites y cachés (opcionales; estos son los valores por defecto) =========
# Los límites por IP y las cachés viven en la memoria del proceso de la API: valen para
# UNA sola réplica. Los topes diarios (capturas, diagnósticos, borradores por cuenta) se
# cuentan en PostgreSQL.

# Diagnósticos públicos por IP en cada ventana. Cada uno es una petición de pago
# a Google (0,025 USD).
FICHAITOR_DIAGNOSIS_RATE_LIMIT=10
FICHAITOR_DIAGNOSIS_RATE_WINDOW_SECONDS=3600
# Diagnósticos públicos entre todos los clientes cada día (UTC): el tope de la factura de
# Places si alguien rota direcciones. Al alcanzarlo, la ruta responde 503 hasta el día
# siguiente. Comprueba también la cuota diaria de la clave en Google Cloud.
FICHAITOR_DIAGNOSIS_DAILY_LIMIT=500

# Segundos que se recuerda a qué place_id llevó un texto de búsqueda (30 días).
FICHAITOR_PLACE_ID_CACHE_SECONDS=2592000

# Altas en la lista de espera por IP en cada ventana.
FICHAITOR_WAITLIST_RATE_LIMIT=5
FICHAITOR_WAITLIST_RATE_WINDOW_SECONDS=3600

# Inicios de conexión con Google por IP y hora.
FICHAITOR_OAUTH_START_RATE_LIMIT=20

# === Resumen de la ficha (opcionales) =========================================

# Horas a partir de las cuales el resumen se da por antiguo y se pide otro.
FICHAITOR_SUMMARY_STALE_HOURS=6
# Como máximo, una sincronización por ficha en cada ventana de estos segundos.
FICHAITOR_SYNC_WINDOW_SECONDS=900

# === Canales de mensajería: Telegram (docs/canales.md) ========================

# Secreto del webhook de Telegram (A-Z, a-z, 0-9, _ y -; hasta 256 caracteres). Sin él,
# la ruta POST /api/v1/webhooks/telegram no existe. El mismo valor va en
# conversation.env para registrar el webhook. Genera uno en el servidor:
#   openssl rand -hex 32
FICHAITOR_TELEGRAM_WEBHOOK_SECRET=
# El MISMO secreto que en conversation.env: mezcla la huella de los códigos de vinculación.
FICHAITOR_LINK_CODE_PEPPER=
# Nombre del bot para el enlace https://t.me/<bot>?start=<testigo>.
FICHAITOR_TELEGRAM_BOT_USERNAME=FichaitorBot
# Códigos de vinculación por cuenta y hora.
FICHAITOR_LINK_CODE_RATE_LIMIT=5
# AQUÍ NO VAN FICHAITOR_TELEGRAM_BOT_TOKEN ni FICHAITOR_CONVERSATION_DATABASE_URL: la API
# no llama a Telegram, solo valida y encola.

# === Correo (solo para saber si hay correo) ===================================
# La API no envía correo: lo hace el worker. Con estos dos valores sabe que el envío
# está configurado; sin ellos, pedir un código de baja responde 503. Sin contraseña.
FICHAITOR_SMTP_HOST=smtp.ionos.es
FICHAITOR_MAIL_FROM=avisos@fichaitor.es
