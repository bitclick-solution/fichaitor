# Copia este archivo a .env. El .env nunca se sube al repositorio.

# Clave de Google Places API (New). Ponle un límite de gasto diario en Google Cloud.
FICHAITOR_PLACES_API_KEY=

# true = usa el negocio de ejemplo y no llama a Google (desarrollo y pruebas).
FICHAITOR_FAKE_PLACES=true

# Diagnósticos por IP (o por cuenta, con sesión) en cada ventana. Cuentan todos, también
# los repetidos: cada diagnóstico es una petición de pago a Google (0,025 USD).
FICHAITOR_DIAGNOSIS_RATE_LIMIT=10
FICHAITOR_DIAGNOSIS_RATE_WINDOW_SECONDS=3600

# Segundos que se recuerda a qué place_id llevó un texto de búsqueda (30 días).
# Solo se guarda el identificador; los datos de la ficha se piden a Google cada vez.
FICHAITOR_PLACE_ID_CACHE_SECONDS=2592000

# Altas en la lista de espera por IP en cada ventana.
FICHAITOR_WAITLIST_RATE_LIMIT=5
FICHAITOR_WAITLIST_RATE_WINDOW_SECONDS=3600

# Base de datos. En local, docker compose ya pone la de desarrollo; aquí solo para producción.
# FICHAITOR_DATABASE_URL=postgresql://usuario:clave@host:5432/fichaitor

# --- Conexión con Google (OAuth) ---------------------------------------------
# Para cambiar de proyecto de Google Cloud basta con cambiar estos tres valores.
# La URI debe estar dada de alta en el cliente OAuth, exactamente igual.
FICHAITOR_GOOGLE_CLIENT_ID=
FICHAITOR_GOOGLE_CLIENT_SECRET=
FICHAITOR_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/oauth/callback

# Secreto para firmar el parámetro state. Genera uno largo y aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FICHAITOR_OAUTH_STATE_SECRET=

# Clave pública que cifra los tokens de Google. Se genera con:
#   uv run python scripts/gen_token_keys.py
# La privada NO va aquí: solo en el worker y en una copia de seguridad aparte.
FICHAITOR_TOKEN_PUBLIC_KEY=
FICHAITOR_TOKEN_KEY_VERSION=1

# Adónde vuelve el navegador tras conectar. Recibe ?google=ok|cancelado|sin_permiso|error
# Con google=ok la API ya ha puesto la cookie de sesión (fichaitor_session, 30 días).
FICHAITOR_POST_CONNECT_URL=/app

# Vale para la cookie de sesión y la del state de OAuth.
# false solo en local con http. En producción, siempre true.
FICHAITOR_COOKIE_SECURE=true

# true solo detrás de un proxy propio que fije X-Forwarded-For.
FICHAITOR_TRUST_PROXY_HEADERS=false

# --- Resumen de la ficha -----------------------------------------------------
# Horas a partir de las cuales el resumen se da por antiguo: la API lo devuelve con
# stale=true y pide una sincronización nueva.
FICHAITOR_SUMMARY_STALE_HOURS=6

# Como máximo, una sincronización por ficha en cada ventana de estos segundos.
FICHAITOR_SYNC_WINDOW_SECONDS=900

# true = conexión con Google de ejemplo, sin llamar a Google (desarrollo y pruebas).
# El worker lee la misma variable y usa su ficha de demostración: tampoco envía a
# Google las respuestas a reseñas. Con false, publicar una respuesta es de verdad.
FICHAITOR_FAKE_GOOGLE=false

# --- Reseñas y respuestas (docs/contrato-web-api.md) ---------------------------
# El borrador de una respuesta lo redacta el modelo de la demostración por captura:
# usa FICHAITOR_GEMINI_API_KEY y FICHAITOR_GEMINI_MODEL, o respuestas de ejemplo con
# FICHAITOR_FAKE_SCREENSHOT=true. Sin ninguna de las dos, el borrador responde 503 y
# el dueño escribe la respuesta; listar y publicar funcionan igual.
# Borradores nuevos por cuenta en cada ventana (cada uno es una llamada de pago).
# El borrador guardado de una reseña que no ha cambiado no cuenta.
FICHAITOR_REVIEW_DRAFT_RATE_LIMIT=30
FICHAITOR_REVIEW_DRAFT_RATE_WINDOW_SECONDS=86400
# Segundos que se espera al modelo antes de responder 503.
FICHAITOR_REVIEW_DRAFT_TIMEOUT_SECONDS=20

# --- Sentimiento del establecimiento (docs/sentimiento.md) ---------------------
# Lo calcula el worker al terminar una sincronización; la API solo lo lee.
# El modelo es el de la captura: FICHAITOR_GEMINI_API_KEY y FICHAITOR_GEMINI_MODEL, o
# FICHAITOR_FAKE_SCREENSHOT=true. El WORKER tiene que recibir esas variables. Sin
# ninguna, hay nota (por estrellas) pero no temas, y los textos salen de reglas fijas.
# Ventana principal de la nota, en meses. Las reseñas anteriores pesan menos.
FICHAITOR_SENTIMENT_WINDOW_MONTHS=12
# Con menos reseñas con texto que estas, el análisis es provisional (sin resumen del modelo).
FICHAITOR_SENTIMENT_MIN_TEXT_REVIEWS=5
# Nota desde la que la valoración es "positivo" y "mixto"; por debajo, "negativo".
FICHAITOR_SENTIMENT_POSITIVE_MIN_SCORE=70
FICHAITOR_SENTIMENT_MIXED_MIN_SCORE=40
# Se recalcula con estas reseñas nuevas, con una de 1 o 2 estrellas, o a estos días si
# hay al menos una nueva. Nunca más de una vez cada MIN_HOURS_BETWEEN (salvo el primero).
# La API usa los dos primeros para redactar "next_update": mismos valores en API y worker.
FICHAITOR_SENTIMENT_NEW_REVIEWS_TRIGGER=3
FICHAITOR_SENTIMENT_MONTHLY_DAYS=30
FICHAITOR_SENTIMENT_MIN_HOURS_BETWEEN=24
# Coste: reseñas por llamada al modelo y llamadas por análisis (una es el resumen).
FICHAITOR_SENTIMENT_BATCH_SIZE=30
FICHAITOR_SENTIMENT_MAX_CALLS=6
# Segundos por llamada. MAX_CALLS x TIMEOUT debe ser menor que el tiempo máximo del job.
FICHAITOR_SENTIMENT_TIMEOUT_SECONDS=15

# Worker (solo el worker lee estas dos)
# En local, la clave privada llega al worker desde ../fichaitor-secretos/worker.env,
# no desde .env: así la API no la recibe en su entorno. Déjala vacía aquí.
FICHAITOR_WORKER_DATABASE_URL=postgresql://fichaitor_worker_dev:dev@127.0.0.1:5433/fichaitor
FICHAITOR_TOKEN_PRIVATE_KEY=

# --- Demostración por captura de reseñas (docs/pantallazo.md) ------------------
# Clave de la API de Gemini, de un proyecto de PAGO (obligatorio para usuarios del
# Espacio Económico Europeo). Sin clave y sin modo falso, la ruta no existe.
FICHAITOR_GEMINI_API_KEY=
FICHAITOR_GEMINI_MODEL=gemini-3.6-flash
# true: respuestas de ejemplo, sin modelo y sin clave (desarrollo y maquetación).
# Vale también para el borrador de las respuestas a reseñas del panel y para el
# sentimiento del establecimiento (en ese caso lo lee el worker).
FICHAITOR_FAKE_SCREENSHOT=false
FICHAITOR_SCREENSHOT_MAX_BYTES=6000000
# Por IP. Más estricto que el diagnóstico de texto: cada captura son hasta dos llamadas de pago.
FICHAITOR_SCREENSHOT_RATE_LIMIT=3
FICHAITOR_SCREENSHOT_RATE_WINDOW_SECONDS=3600
# Entre todos los clientes, cada 24 horas
FICHAITOR_SCREENSHOT_DAILY_LIMIT=300
FICHAITOR_SCREENSHOT_TIMEOUT_SECONDS=30
FICHAITOR_SCREENSHOT_MIN_CONFIDENCE=0.6
