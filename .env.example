# Copia este archivo a .env. El .env nunca se sube al repositorio.

# Clave de Google Places API (New). Ponle un límite de gasto diario en Google Cloud.
FICHAITOR_PLACES_API_KEY=

# true = usa el negocio de ejemplo y no llama a Google (desarrollo y pruebas).
FICHAITOR_FAKE_PLACES=true

# Diagnósticos por IP (o por cuenta, con sesión) en cada ventana. Cuentan todos, también
# los repetidos: cada diagnóstico es una petición de pago a Google (0,025 USD).
FICHAITOR_DIAGNOSIS_RATE_LIMIT=10
FICHAITOR_DIAGNOSIS_RATE_WINDOW_SECONDS=3600

# Segundos que se recuerda a qué place_id llevó un texto de búsqueda (30 días).
# Solo se guarda el identificador; los datos de la ficha se piden a Google cada vez.
FICHAITOR_PLACE_ID_CACHE_SECONDS=2592000

# Altas en la lista de espera por IP en cada ventana.
FICHAITOR_WAITLIST_RATE_LIMIT=5
FICHAITOR_WAITLIST_RATE_WINDOW_SECONDS=3600

# Base de datos. En local, docker compose ya pone la de desarrollo; aquí solo para producción.
# FICHAITOR_DATABASE_URL=postgresql://usuario:clave@host:5432/fichaitor

# --- Conexión con Google (OAuth) ---------------------------------------------
# Para cambiar de proyecto de Google Cloud basta con cambiar estos tres valores.
# La URI debe estar dada de alta en el cliente OAuth, exactamente igual.
FICHAITOR_GOOGLE_CLIENT_ID=
FICHAITOR_GOOGLE_CLIENT_SECRET=
FICHAITOR_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/oauth/callback

# Secreto para firmar el parámetro state. Genera uno largo y aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FICHAITOR_OAUTH_STATE_SECRET=

# Clave pública que cifra los tokens de Google. Se genera con:
#   uv run python scripts/gen_token_keys.py
# La privada NO va aquí: solo en el worker y en una copia de seguridad aparte.
FICHAITOR_TOKEN_PUBLIC_KEY=
FICHAITOR_TOKEN_KEY_VERSION=1

# Adónde vuelve el navegador tras conectar. Recibe ?google=ok|cancelado|sin_permiso|error
# Con google=ok la API ya ha puesto la cookie de sesión (fichaitor_session, 30 días).
FICHAITOR_POST_CONNECT_URL=/app

# Vale para la cookie de sesión y la del state de OAuth.
# false solo en local con http. En producción, siempre true.
FICHAITOR_COOKIE_SECURE=true

# true solo detrás de un proxy propio que fije X-Forwarded-For.
FICHAITOR_TRUST_PROXY_HEADERS=false

# --- Resumen de la ficha -----------------------------------------------------
# Horas a partir de las cuales el resumen se da por antiguo: la API lo devuelve con
# stale=true y pide una sincronización nueva.
FICHAITOR_SUMMARY_STALE_HOURS=6

# Como máximo, una sincronización por ficha en cada ventana de estos segundos.
FICHAITOR_SYNC_WINDOW_SECONDS=900

# true = conexión con Google de ejemplo, sin llamar a Google (desarrollo y pruebas).
# El worker lee la misma variable y usa su ficha de demostración.
FICHAITOR_FAKE_GOOGLE=false

# Worker (solo el worker lee estas dos)
# En local, la clave privada llega al worker desde ../fichaitor-secretos/worker.env,
# no desde .env: así la API no la recibe en su entorno. Déjala vacía aquí.
FICHAITOR_WORKER_DATABASE_URL=postgresql://fichaitor_worker_dev:dev@127.0.0.1:5433/fichaitor
FICHAITOR_TOKEN_PRIVATE_KEY=
