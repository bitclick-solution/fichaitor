# Copia este archivo a .env. El .env nunca se sube al repositorio.

# Clave de Google Places API (New). Ponle un límite de gasto diario en Google Cloud.
FICHAITOR_PLACES_API_KEY=

# true = usa el negocio de ejemplo y no llama a Google (desarrollo y pruebas).
FICHAITOR_FAKE_PLACES=true

# Consultas nuevas por IP en cada ventana. Las repetidas salen de la caché y no cuentan.
FICHAITOR_DIAGNOSIS_RATE_LIMIT=10
FICHAITOR_DIAGNOSIS_RATE_WINDOW_SECONDS=3600
FICHAITOR_DIAGNOSIS_CACHE_SECONDS=86400

# Altas en la lista de espera por IP en cada ventana.
FICHAITOR_WAITLIST_RATE_LIMIT=5
FICHAITOR_WAITLIST_RATE_WINDOW_SECONDS=3600

# Base de datos. En local, docker compose ya pone la de desarrollo; aquí solo para producción.
# FICHAITOR_DATABASE_URL=postgresql://usuario:clave@host:5432/fichaitor

# true solo detrás de un proxy propio que fije X-Forwarded-For.
FICHAITOR_TRUST_PROXY_HEADERS=false
